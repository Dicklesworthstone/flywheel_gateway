# SQLite databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Daemon runtime files
daemon.lock
daemon.log
daemon.pid
bd.sock

# Local version tracking
.local_version

# Legacy database files
db.sqlite
bd.db

# Compressed daemon logs
daemon-*.log.gz

# Merge artifacts (temporary files during 3-way merge)
beads.base.jsonl
beads.left.jsonl
beads.right.jsonl
beads.base.meta.json
beads.left.meta.json
beads.right.meta.json

# Additional runtime files
redirect
last-touched

# Keep JSONL exports and config (source of truth for git)
!issues.jsonl
!config.json
!metadata.json

# Local history backups
.br_history/

# bv (beads viewer) lock file
.bv.lock

# br fsqlite-ns VFS sidecars — per-machine runtime state, like -wal/-shm.
# Covers beads.db-fsqlite-ns-{gate,use} and vacuum copies named
# .beads.db.schema-migration-<ts>-<pid>-0.vacuum-fsqlite-ns-{gate,use}.
*-fsqlite-ns-gate
*-fsqlite-ns-use
